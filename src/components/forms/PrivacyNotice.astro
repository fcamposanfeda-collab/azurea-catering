---
import { legal } from '../../data/legal';

interface Props {
  purpose?: string;
}

const { purpose = 'atender tu solicitud y preparar el presupuesto' } = Astro.props;
---

<div class="privacy-notice">
  <label class="privacy-notice__check">
    <input type="checkbox" name="privacidad" value="Aceptada" required />
    <span>He leído la <a href="/politica-de-privacidad/">política de privacidad</a> y acepto el tratamiento de mis datos para {purpose === 'atender tu solicitud y preparar el presupuesto' ? 'recibir la propuesta' : 'recibir el dossier y que podáis contactarme'}.</span>
  </label>
  <p class="privacy-notice__info">
    Responsable: {legal.holder}. Finalidad: {purpose}. No se ceden
    datos a terceros salvo obligación legal. Puedes ejercer tus derechos de acceso, rectificación, supresión
    y demás escribiendo al email de contacto.
  </p>
</div>
