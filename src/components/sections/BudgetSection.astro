---
import { budgetApproach } from '../../data/content';
---

<section class="section section--header">
  <div class="container">
    <div class="section-header section-header--center" data-reveal>
      <span class="eyebrow">{budgetApproach.eyebrow}</span>
      <h2>{budgetApproach.title}</h2>
      <p class="lead">{budgetApproach.lead}</p>
    </div>
    <div class="grid grid--3">
      {
        budgetApproach.points.map((point) => (
          <div class="card" data-reveal>
            <h3>{point.title}</h3>
            <p>{point.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
