---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import SplitPhoto from '../components/ui/SplitPhoto.astro';
import BudgetCallout from '../components/ui/BudgetCallout.astro';
import { getPageMeta } from '../data/pages-meta';
import { routes } from '../data/routes';

const meta = getPageMeta('/eventos');
---

<BaseLayout title={meta.title} description={meta.description}>
  <section class="page-hero">
    <div class="container section-header" data-reveal>
      <h1>
        <span class="hero__kicker">Catering para eventos en Ciudad Real</span>
        Catering para empresas, cumpleaños y eventos privados
      </h1>
      <p class="lead">
        Desde un cóctel corporativo hasta una celebración íntima, creamos soluciones flexibles según el
        presupuesto y el tipo de evento que quieras celebrar. El servicio cubre Ciudad Real y localidades
        a alrededor de una hora.
      </p>
      <BudgetCallout />
      <div class="cta-actions">
        <Button href={routes.contact} size="lg">Hablar de mi evento</Button>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid--3">
      <a class="card" href={routes.business} data-reveal><span class="card__meta">Empresas</span><h3>Catering para empresas</h3><p>Cenas de Navidad, coffee breaks, presentaciones, inauguraciones y cócteles con una imagen cuidada.</p></a>
      <a class="card" href={routes.celebrations} data-reveal><span class="card__meta">Privados</span><h3>Cumpleaños y celebraciones</h3><p>Cumpleaños, aniversarios y bautizos en casa, finca, jardín o espacio privado.</p></a>
      <a class="card" href={routes.createEvent} data-reveal><span class="card__meta">Especiales</span><h3>Celebraciones a medida</h3><p>Un formato diseñado desde cero cuando el evento pide algo diferente.</p></a>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container split">
      <SplitPhoto
        src="/images/optimized/azurea-brindis.webp"
        alt="Servicio de cava en copas durante un evento de Azurea"
      />
      <div data-reveal>
        <span class="eyebrow">Profesionalidad</span>
        <h2>Un servicio que se adapta al objetivo del encuentro</h2>
        <p class="lead">
          Cuidamos la estética, los tiempos y la comodidad para que el catering acompañe al evento sin
          robar protagonismo.
        </p>
        <ul class="feature-list">
          <li>Propuestas dulces, saladas o mixtas.</li>
          <li>Servicio de cóctel, buffet o estaciones.</li>
          <li>Montaje y presentación ajustados al espacio.</li>
          <li>Opciones para grupos reducidos o eventos con más invitados.</li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

