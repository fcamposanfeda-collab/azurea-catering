---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import BudgetCallout from '../components/ui/BudgetCallout.astro';
import { getPageMeta } from '../data/pages-meta';
import { routes } from '../data/routes';

const meta = getPageMeta('/bodas');
---

<BaseLayout title={meta.title} description={meta.description}>
  <section class="page-hero">
    <div class="container section-header" data-reveal>
      <span class="eyebrow">Bodas</span>
      <h1>Un catering de boda pensado hasta el último detalle</h1>
      <p class="lead">
        Una boda no es un evento más. Diseñamos una experiencia gastronómica que acompaña el día completo,
        con propuestas adaptadas al presupuesto que queráis destinar.
      </p>
      <BudgetCallout />
      <div class="cta-actions">
        <Button href={routes.contact} size="lg">Pedir presupuesto de boda</Button>
        <Button href={routes.services} variant="outline" size="lg">Ver formatos</Button>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div
        class="split__media"
        style="--image: url('/images/optimized/azurea-celebracion.webp')"
        aria-hidden="true"
        data-reveal
      >
      </div>
      <div data-reveal>
        <span class="eyebrow">Experiencia completa</span>
        <h2>Desde el primer aperitivo hasta el último brindis</h2>
        <p class="lead">
          Creamos propuestas que encajan con vuestro estilo: bodas íntimas, celebraciones familiares,
          fincas, jardines o espacios singulares.
        </p>
        <ul class="feature-list">
          <li>Cóctel de bienvenida con aperitivos fríos y calientes.</li>
          <li>Menú servido en mesa o formato mixto con estaciones.</li>
          <li>Opciones para intolerancias, niños e invitados especiales.</li>
          <li>Coordinación de tiempos para que el servicio acompañe el ritmo del día.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="section-header section-header--center" data-reveal>
        <span class="eyebrow">Momentos</span>
        <h2>Un recorrido gastronómico con intención</h2>
      </div>
      <div class="grid grid--3">
        <div class="card card--dark" data-reveal><span class="card__number">01</span><h3>Bienvenida</h3><p>Bebidas, primeros bocados y una llegada cuidada para romper el hielo.</p></div>
        <div class="card card--dark" data-reveal><span class="card__number">02</span><h3>Cóctel o banquete</h3><p>Un formato elegante, cómodo y adaptado al espacio y al número de invitados.</p></div>
        <div class="card card--dark" data-reveal><span class="card__number">03</span><h3>Final dulce</h3><p>Postres, mesa dulce o detalles finales para cerrar la celebración con sabor.</p></div>
      </div>
    </div>
  </section>

  <section class="section section--header">
    <div class="container">
      <div class="section-header section-header--center" data-reveal>
        <span class="eyebrow">Más allá del catering</span>
        <h2>Te ayudamos en tu boda desde mucho antes del gran día</h2>
        <p class="lead">
          No solo nos ocupamos del menú. Podemos acompañaros desde la pedida o la preboda, con papelería,
          decoración, flores, seating plan y cada detalle que hace única vuestra celebración.
        </p>
      </div>
      <div class="grid grid--3">
        <div class="card" data-reveal>
          <span class="card__meta">Antes del día</span>
          <h3>Invitaciones y papelería</h3>
          <p>Save the date, invitaciones, seating plan y detalles impresos con una estética coherente con vuestra boda.</p>
        </div>
        <div class="card" data-reveal>
          <span class="card__meta">Ambiente</span>
          <h3>Decoración y flores</h3>
          <p>Mesas, rincones, flores y puesta en escena para que el espacio refleje vuestro estilo desde la llegada.</p>
        </div>
        <div class="card" data-reveal>
          <span class="card__meta">Experiencias</span>
          <h3>Corners y momentos especiales</h3>
          <p>Mesas de glitter, candy bar, estaciones de vino, queso o jamón, y cualquier corner que queráis imaginar.</p>
        </div>
        <div class="card" data-reveal>
          <span class="card__meta">Recuerdos</span>
          <h3>Fotos instantáneas</h3>
          <p>Contamos con proveedores de fotos instantáneas para que los invitados se lleven un recuerdo del momento.</p>
        </div>
        <div class="card" data-reveal>
          <span class="card__meta">Música</span>
          <h3>Grupos y DJs</h3>
          <p>Os ponemos en contacto con grupos musicales o DJs para que el ambiente acompañe cada parte de la celebración.</p>
        </div>
        <div class="card" data-reveal>
          <span class="card__meta">Todo junto</span>
          <h3>Un solo interlocutor</h3>
          <p>Coordinamos catering, decoración, corners y proveedores para que todo encaje y vosotros podáis disfrutar.</p>
        </div>
      </div>
      <div class="cta-actions cta-actions--center" data-reveal>
        <Button href={routes.contact} size="lg">Cuéntanos vuestra boda</Button>
        <Button href={routes.createEvent} variant="outline" size="lg">Crea otro tipo de evento</Button>
      </div>
    </div>
  </section>
</BaseLayout>

